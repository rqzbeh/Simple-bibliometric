# Groq AI API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq AI Model (default: llama-3.1-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, etc.
GROQ_MODEL=llama-3.1-70b-versatile

# Academic Database API Keys (to be added by user)
WOS_API_KEY=your_wos_api_key
SCOPUS_API_KEY=your_scopus_api_key
SCIENCEDIRECT_API_KEY=your_sciencedirect_api_key
PUBMED_API_KEY=your_pubmed_api_key
PUBCHEM_API_KEY=your_pubchem_api_key
GENE_API_KEY=your_gene_api_key
GENOME_API_KEY=your_genome_api_key
SAGE_API_KEY=your_sage_api_key
IEEE_API_KEY=your_ieee_api_key
EMERALD_API_KEY=your_emerald_api_key
ERIC_API_KEY=your_eric_api_key
SPRINGER_API_KEY=your_springer_api_key
EBSCO_API_KEY=your_ebsco_api_key
WILEY_API_KEY=your_wiley_api_key
