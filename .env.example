# Example .env file for Simple-bibliometric
# Copy this to `.env` and replace placeholder values with your own keys.
# IMPORTANT: Do NOT commit real API keys to source control.

############################################################
# Required (at least GROQ_API_KEY for full AI functionality)
############################################################
# Groq API key (required for AI analysis/filtering)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (optional). If unset, the crawler will attempt to choose a good default.
# Example: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

############################################################
# NCBI / Entrez (optional — Biopython Entrez can be used without a key)
############################################################
# Contact email recommended by NCBI to identify your requests
NCBI_EMAIL=your_email@example.com

# (Optional) NCBI API key to increase rate limits (if you have one)
PUBMED_API_KEY=your_pubmed_api_key_here
GENE_API_KEY=your_gene_api_key_here
GENOME_API_KEY=your_genome_api_key_here
PUBCHEM_API_KEY=your_pubchem_api_key_here

############################################################
# Publisher / Vendor API keys (many of these require registration)
# If not provided, the crawler will attempt package-based or public endpoints
# where available (e.g., PubChem via pubchempy, CrossRef via habanero).
############################################################
# Clarivate - Web of Science
WOS_API_KEY=your_wos_api_key_here

# Elsevier - Scopus & ScienceDirect
SCOPUS_API_KEY=your_scopus_api_key_here
SCIENCEDIRECT_API_KEY=your_sciencedirect_api_key_here

# IEEE Xplore
IEEE_API_KEY=your_ieee_api_key_here

# Springer Nature
SPRINGER_API_KEY=your_springer_api_key_here

# EBSCO (OAuth / client credentials)
EBSCO_API_KEY=your_ebsco_api_key_here
EBSCO_CLIENT_ID=your_ebsco_client_id_here
EBSCO_CLIENT_SECRET=your_ebsco_client_secret_here

# Wiley TDM (institutional)
WILEY_API_KEY=your_wiley_api_key_here

# ERIC (optional; often no key required)
ERIC_API_KEY=your_eric_api_key_here

# SAGE (CrossRef is used by default and typically requires no key)
SAGE_API_KEY=your_sage_api_key_here (optional)

############################################################
# Optional runtime configuration
############################################################
# Default maximum results per database (can be overridden in code)
DEFAULT_MAX_RESULTS=100

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

############################################################
# Notes
############################################################
# - For sources that can be accessed via Python packages (PubMed/Entrez via Biopython,
#   PubChem via pubchempy, CrossRef via habanero), installing those packages allows
#   the crawler to prefer package-based access, reducing the need for provider API keys.
#
# - Use the included utilities to inspect and select Groq models:
#   `inspect_groq_models.py --suggest --test` (will help select a working Groq model).
#
# - Keep this file private (do not commit actual `.env` with secrets into version control).
#
# - If you need help generating or installing keys for specific providers, let me know
#   and I can help with the registration / configuration steps.
