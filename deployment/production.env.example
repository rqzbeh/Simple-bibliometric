# Production Environment Configuration Example
# Copy this file to .env and update with your actual values

############################################################
# REQUIRED: Core AI Configuration
############################################################
GROQ_API_KEY=your_production_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

############################################################
# NCBI Services (optional for higher rate limits)
############################################################
NCBI_EMAIL=admin@yourdomain.com
PUBMED_API_KEY=your_pubmed_key
GENE_API_KEY=your_gene_key
GENOME_API_KEY=your_genome_key
PUBCHEM_API_KEY=your_pubchem_key

############################################################
# Premium Database APIs
############################################################
WOS_API_KEY=your_wos_production_key
SCOPUS_API_KEY=your_scopus_production_key
SCIENCEDIRECT_API_KEY=your_sciencedirect_production_key
IEEE_API_KEY=your_ieee_production_key
SPRINGER_API_KEY=your_springer_production_key
EBSCO_API_KEY=your_ebsco_production_key
EBSCO_CLIENT_ID=your_ebsco_client_id
EBSCO_CLIENT_SECRET=your_ebsco_client_secret
WILEY_API_KEY=your_wiley_production_key
ERIC_API_KEY=your_eric_key
SAGE_API_KEY=your_sage_key

############################################################
# Cerebras Fallback (optional)
############################################################
CEREBRAS_API_KEY=your_cerebras_production_key
CEREBRAS_MODEL=llama-3.3-70b

############################################################
# Production Runtime Configuration
############################################################
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Default maximum results per database
DEFAULT_MAX_RESULTS=200

# Cache settings
CACHE_TTL_HOURS=24

############################################################
# Job Queue Configuration (Production with RQ + Redis)
############################################################
# Enable RQ backend (1 = enabled, 0 = disabled/in-process)
BIB_USE_RQ=1

# Redis connection URL
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis password (if authentication is enabled)
# REDIS_PASSWORD=your_strong_redis_password

# Job output directory (where analysis artifacts are stored)
BIB_JOB_OUTPUT_DIR=/var/lib/bib-jobs

############################################################
# Security Configuration
############################################################
# CORS allowed origins (comma-separated)
# For production, restrict to your domain(s)
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Maximum file upload size (MB)
MAX_UPLOAD_SIZE_MB=100

############################################################
# Performance Tuning
############################################################
# Number of API worker processes (recommended: 2x CPU cores)
API_WORKERS=4

# Number of RQ worker processes
RQ_WORKERS=4

# Maximum concurrent jobs per worker
MAX_CONCURRENT_JOBS=2

# Job timeout (seconds) - how long a job can run before being killed
JOB_TIMEOUT=3600

# Result TTL (seconds) - how long to keep job results
RESULT_TTL=86400

# Job failure TTL (seconds) - how long to keep failed job records
FAILURE_TTL=604800

############################################################
# Database Connection Pooling (if using PostgreSQL/MySQL)
############################################################
# DATABASE_URL=postgresql://user:password@localhost:5432/bibliometric
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

############################################################
# Monitoring and Alerting
############################################################
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Prometheus metrics endpoint (optional)
# ENABLE_METRICS=1
# METRICS_PORT=9090

############################################################
# External Services (optional)
############################################################
# AWS S3 for storing large files (optional)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=bibliometric-outputs
# AWS_S3_REGION=us-east-1

# Email notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@yourdomain.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@yourdomain.com

############################################################
# Feature Flags
############################################################
# Enable/disable specific features
ENABLE_STREAMLIT_DASHBOARD=1
ENABLE_FLUTTER_UI=1
ENABLE_NETWORK_VISUALIZATION=1
ENABLE_TIME_SERIES_FORECASTING=1

############################################################
# Notes for Production
############################################################
# 1. NEVER commit this file with real credentials to version control
# 2. Use strong, unique passwords for Redis and database
# 3. Rotate API keys regularly (quarterly recommended)
# 4. Enable TLS/SSL for all external connections
# 5. Set up monitoring and alerting for all services
# 6. Implement automated backups for Redis and job outputs
# 7. Review and update dependencies regularly for security patches
# 8. Use a secrets management service (AWS Secrets Manager, HashiCorp Vault)
#    instead of plain text .env files for sensitive production environments
